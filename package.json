{
  "name": "kalamesaz",
  "version": "1.0.0",
  "private": true,
  "description": "بازی کلمات فارسی — ساخت کلمه از حروف",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "fonts:link": "tsx tools/link-fonts.mts",
    "data:check": "tsx tools/check-levels.mts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "levels:build": "tsx tools/build-levels.mts",
    "levels:check": "tsx tools/check-levels.mts",
    "sounds:build": "tsx tools/build-sounds.mts",
    "icons:build": "tsx tools/build-icons.mts",
    "android:preflight": "tsx tools/preflight.mts",
    "apk:verify": "bash tools/verify-apk.sh",
    "android:clean": "cd android && ./gradlew clean",
    "android:apk:release": "cd android && ./gradlew assembleRelease",
    "android:aab:release": "cd android && ./gradlew bundleRelease",
    "android:apk:splits": "cd android && ./gradlew assembleRelease -PabiSplits=true",
    "android:bundle:debug": "cd android && ./gradlew assembleDebug",
    "solutions:export": "tsx tools/export-solutions.mts",
    "icons:mascot": "tsx tools/build-mascot-icon.mts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "opentype.js": "^2.0.0",
    "prettier": "^2.8.8",
    "sharp": "^0.35.5",
    "test-renderer": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
