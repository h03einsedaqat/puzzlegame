# این فایل را با نام keystore.properties در پوشه android/ کپی کنید و مقادیر را پر کنید.
# فایل keystore.properties و فایل کلید (*.jks) هرگز نباید وارد Git شوند.

# ساخت کلید امضا (یک‌بار برای همیشه؛ گم شدن آن یعنی از دست دادن امکان به‌روزرسانی):
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore kalamesaz-release.jks -alias kalamesaz \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=../../keys/kalamesaz-release.jks
storePassword=CHANGE_ME
keyAlias=kalamesaz
keyPassword=CHANGE_ME
